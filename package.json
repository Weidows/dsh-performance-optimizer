{
  "name": "@local/dsh-performance-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle that exposes host-wide and per-event-loop performance metrics (CPU / memory / IO / chat DOM) via a Settings tab, an optional HUD, an in-process MCP server, and a native agent tool.",
  "keywords": [
    "dsh-plugin",
    "performance",
    "diagnostics"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-shell"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
